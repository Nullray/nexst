+/* Called before the owning PCI device, engine queues or BARs are destroyed. */
+void cdev_ctrl_cleanup(struct xdma_cdev *xcdev)
+{
+	if (xcdev->magic != MAGIC_CHAR)
+		return;
+	mutex_lock(&nexst_dma32_mutex);
+	xcdev->dma32_removing = true;
+	if (dma32_db_free_ioctl(xcdev)) {
+		/* remove cannot be aborted. Keep DMA memory and its allocation
+		 * device alive rather than reuse possibly active memory. No new
+		 * probe can inherit these objects: state is exclusively per cdev.
+		 */
+		get_device(&xcdev->xdev->pdev->dev);
+		xcdev->dma32_owner = NULL;
+	}
+	mutex_unlock(&nexst_dma32_mutex);
+}
+
+static int char_ctrl_close(struct inode *inode, struct file *file)
+{
+	struct xdma_cdev *xcdev = file->private_data;
+	int rv = char_close(inode, file);
+
+	if (rv)
+		return rv;
+	mutex_lock(&nexst_dma32_mutex);
+	if (!xcdev->dma32_removing && xcdev->dma32_owner == file) {
+		rv = dma32_db_free_ioctl(xcdev);
+		/* A failed stop retains the allocation, not a dangling file ptr. */
+		xcdev->dma32_owner = NULL;
+	}
+	mutex_unlock(&nexst_dma32_mutex);
+	return rv;
+}
+
+/* Called with nexst_dma32_mutex held; QUERY never grants mutation rights. */
+static int dma32_db_access(struct xdma_cdev *xcdev, struct file *file, bool query)
+{
+	if (xcdev->dma32_removing)
+		return -ENODEV;
+	if (xcdev != &xcdev->xpdev->ctrl_cdev)
+		return -EINVAL;
+	if (!query && xcdev->dma32_owner && xcdev->dma32_owner != file)
+		return -EBUSY;
 	return 0;
 }
 
