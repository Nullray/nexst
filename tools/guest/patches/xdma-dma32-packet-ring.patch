diff --git a/XDMA/linux-kernel/xdma/nexst_dma32_ring.h b/XDMA/linux-kernel/xdma/nexst_dma32_ring.h
new file mode 100644
index 0000000000000000000000000000000000000000..a4c27031b2457ea3b063315a3b9484c6437bd806
--- /dev/null
+++ b/XDMA/linux-kernel/xdma/nexst_dma32_ring.h
@@ -0,0 +1,36 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef NEXST_DMA32_RING_H
+#define NEXST_DMA32_RING_H
+
+/* The proxy sends a 32-byte AXI-Stream packet with TLAST. PG195 requires
+ * C2H descriptor buffers to have a length divisible by 64. TLAST closes
+ * the current descriptor, even if its buffer has unused space.
+ */
+#define NEXST_PROXY_PACKET_BYTES 32U
+#define NEXST_PROXY_RX_SLOT_BYTES 64U
+
+/* transfer_desc_init/xdma_desc_set/xdma_desc_link are supplied by libxdma.
+ * Keep C2H metadata inside the unused half of each slot, never at address 0.
+ * QEMU scans 32-byte records and ignores the metadata's different magic.
+ */
+static inline void nexst_dma32_ring_init(struct xdma_transfer *transfer,
+				       dma_addr_t buffer_bus)
+{
+	int i;
+
+	transfer_desc_init(transfer, transfer->desc_num);
+	for (i = 0; i < transfer->desc_num; i++) {
+		dma_addr_t slot_bus = buffer_bus +
+			(size_t)i * NEXST_PROXY_RX_SLOT_BYTES;
+
+		xdma_desc_set(transfer->desc_virt + i, slot_bus,
+			      slot_bus + NEXST_PROXY_PACKET_BYTES,
+			      NEXST_PROXY_RX_SLOT_BYTES, transfer->dir);
+		/* No stop or completion interrupts on the polling ring. */
+		xdma_desc_control_set(transfer->desc_virt + i, 0);
+	}
+	xdma_desc_link(transfer->desc_virt + transfer->desc_num - 1,
+		       transfer->desc_virt, transfer->desc_bus);
+}
+
+#endif
